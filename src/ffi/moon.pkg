import {
  "moonbitlang/core/json",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/js_async",
  "moonbitlang/core/cmp",
  "moonbitlang/core/debug",
  "moonbitlang/async/process",
  "mizchi/x/process" @x_process,
  "mizchi/x/sys" @x_sys,
}

warnings = "-0067-0029"

options(
  "native-stub": [ "native_stub.c" ],
  targets: {
    "async_js.mbt": [ "js" ],
    "x_async.mbt": [ "js" ],
    "process.mbt": [ "native", "wasm" ],
    "raw_js.mbt": [ "js" ],
    "raw_native.mbt": [ "native" ],
    "raw_wasm.mbt": [ "wasm", "wasm-gc" ],
    "string_conv.mbt": [ "native" ],
  },
)
